---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE_NAME } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/images/arcade.jpg', noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const absoluteImage = Astro.site ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#862f25" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    {canonical && !noindex && <link rel="canonical" href={canonical.toString()} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.toString()} />}
    {absoluteImage && <meta property="og:image" content={absoluteImage.toString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <script is:inline src="/consent.js" defer></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">본문 바로가기</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
    <CookieConsent />
  </body>
</html>
